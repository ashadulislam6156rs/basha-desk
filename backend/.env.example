NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# Neon/PostgreSQL: app uses the pooled URL; Prisma CLI needs a direct dev-branch URL.
DATABASE_URL=postgresql://basha_app:REPLACE_ME@YOUR_POOLER_HOST/bashadesk_db?sslmode=require
DATABASE_MIGRATE_URL=postgresql://basha_owner:REPLACE_ME@YOUR_DIRECT_HOST/bashadesk_db?sslmode=require
DATABASE_TARGET=development
ALLOW_PRODUCTION_MIGRATIONS=NO
DB_TENANT_SETTING=app.tenant_id
