// =====================================================================================
// Basha Desk — Prisma schema  (PostgreSQL 17+)
// উৎস: docs/05_Schema.md  ·  এই ফাইলে যা প্রকাশ করা যায় না (RLS policy, EXCLUDE, CHECK,
// trigger, partial index, generated column, self-FK) সব prisma/sql/rls_and_constraints.sql এ।
// দুটো ফাইল **একসাথে** migration এ যাবে। docs এর সাথে বিরোধ হলে 05_Schema.md জেতে।
// নামকরণ: Tenant = SaaS ক্লায়েন্ট; Renter = ভাড়াটিয়া।
//
// RBAC রিভিশন (এই ভার্সনে যা বদলেছে):
//  1. Platform RBAC: enum PlatformRole সরানো হয়েছে → PlatformRole / PlatformPermission /
//     PlatformRolePermission মডেল। PlatformUser.roleId। PlatformRole.isSuperAdmin = true হলে
//     সব permission check bypass (অ্যাপ লেয়ারে)।
//  2. Permission / PlatformPermission এ module + action (enum) + scopeType + sortOrder।
//  3. Role.baseRoleId (system role ক্লোন করে কাস্টমাইজ)।
//  4. Membership.scopeAll / Invite.scopeAll ("সব property" বনাম "নির্দিষ্ট property")।
// =====================================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pg_trgm, btree_gist, pgcrypto]
}

// ----------------------------------------------- ENUMS -----------------------------------------------

enum TenantStatus {
  PROVISIONING
  PROVISION_FAILED
  READY
  SUSPENDED
  CANCELLED
  ARCHIVED
  @@map("tenant_status")
}

enum DbMode {
  SHARED
  DEDICATED
  @@map("db_mode")
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
  @@map("domain_type")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  @@map("verification_status")
}

enum SslStatus {
  PENDING
  ACTIVE
  ERROR
  @@map("ssl_status")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  @@map("subscription_status")
}

enum PlatformInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  @@map("platform_invoice_status")
}

// permission এর action (module-wise checkbox matrix এর কলাম)
enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  ARCHIVE
  RESTORE
  RESET
  APPROVE
  VOID
  EXPORT
  IMPORT
  ASSIGN
  @@map("permission_action")
}

// GLOBAL = পুরো tenant/platform এ প্রযোজ্য; PROPERTY = property scope দ্বারা সীমিত (শুধু tenant permission এ অর্থবহ)
enum PermissionScopeType {
  GLOBAL
  PROPERTY
  @@map("permission_scope_type")
}

enum UserKind {
  STAFF
  RENTER
  @@map("user_kind")
}

enum OtpPurpose {
  RENTER_LOGIN
  SIGNUP
  INVITE
  @@map("otp_purpose")
}

enum SpaceType {
  FLAT
  SHOP
  PARKING
  ROOM
  SEAT
  OTHER
  @@map("space_type")
}

enum SpaceStatus {
  VACANT
  OCCUPIED
  RESERVED
  MAINTENANCE
  @@map("space_status")
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  ENDING
  ENDED
  CANCELLED
  @@map("agreement_status")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  @@map("invoice_status")
}

enum InvoiceSource {
  AUTO
  MANUAL
  @@map("invoice_source")
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  BANK
  CARD
  OTHER
  @@map("payment_method")
}

enum PaymentStatus {
  RECORDED
  VOID
  @@map("payment_status")
}

enum AllocationKind {
  INVOICE
  CREDIT
  @@map("allocation_kind")
}

enum ChargeFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
  @@map("charge_frequency")
}

enum ChargeCategory {
  RENT
  SERVICE_CHARGE
  ELECTRICITY
  GAS
  WATER
  PARKING
  LATE_FEE
  OTHER
  @@map("charge_category")
}

enum DepositTxnType {
  RECEIVED
  ADJUSTED
  REFUNDED
  FORFEITED
  @@map("deposit_txn_type")
}

enum LateFeeType {
  FIXED
  PERCENT
  PER_DAY
  @@map("late_fee_type")
}

enum UtilityKind {
  ELECTRICITY
  GAS
  WATER
  @@map("utility_kind")
}

enum RenterDocKind {
  NID_FRONT
  NID_BACK
  PHOTO
  AGREEMENT_SCAN
  OTHER
  @@map("renter_doc_kind")
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  @@map("maintenance_status")
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  @@map("maintenance_priority")
}

enum NoticeAudience {
  ALL
  PROPERTY
  SELECTED
  @@map("notice_audience")
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  @@map("notification_channel")
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED_QUOTA
  @@map("notification_status")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
