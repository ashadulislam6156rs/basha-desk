}

enum JournalSource {
  INVOICE_ISSUED
  PAYMENT
  PAYMENT_VOID
  INVOICE_VOID
  DEPOSIT
  EXPENSE
  @@map("journal_source")
}

enum ExpenseStatus {
  RECORDED
  VOID
  @@map("expense_status")
}

enum ActorKind {
  USER
  SYSTEM
  SUPPORT
  @@map("actor_kind")
}

enum AiRole {
  USER
  ASSISTANT
  TOOL
  @@map("ai_role")
}

// ----------------------------------------------- MODELS ----------------------------------------------

model Plan {
  id String @id @default(uuid(7)) @db.Uuid
  code String @unique
  nameBn String @map("name_bn")
  nameEn String @map("name_en")
  priceMonthly Decimal? @db.Decimal(14, 2) @map("price_monthly")
  currency String @default("BDT") @db.Char(3)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  planEntitlementsByPlan PlanEntitlement[] @relation("PlanEntitlement_plan")
  subscriptionsByPlan Subscription[] @relation("Subscription_plan")

  @@map("plans")
}

model PlanEntitlement {
  planId String @db.Uuid @map("plan_id")
  key String
  valueInt Int? @map("value_int")
  valueBool Boolean? @map("value_bool")
  isUnlimited Boolean @default(false) @map("is_unlimited")

  plan Plan @relation("PlanEntitlement_plan", fields: [planId], references: [id], onDelete: Restrict)

  @@id([planId, key])
  @@map("plan_entitlements")
}

model Tenant {
  id String @id @default(uuid(7)) @db.Uuid
  slug String @unique @db.Citext
  name String
  status TenantStatus @default(PROVISIONING)
  statusReason String? @map("status_reason")
  dbMode DbMode @default(SHARED) @map("db_mode")
  dbConnectionRef String? @map("db_connection_ref")
  defaultLocale String @default("bn") @map("default_locale")
  timezone String @default("Asia/Dhaka")
  currency String @default("BDT") @db.Char(3)
  ownerUserId String? @db.Uuid @map("owner_user_id")
  branding Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")
  suspendedAt DateTime? @db.Timestamptz(6) @map("suspended_at")
  cancelledAt DateTime? @db.Timestamptz(6) @map("cancelled_at")
  archivedAt DateTime? @db.Timestamptz(6) @map("archived_at")

  tenantDomains TenantDomain[] @relation("TenantDomain_tenant")
  subscriptions Subscription[] @relation("Subscription_tenant")
  platformInvoices PlatformInvoice[] @relation("PlatformInvoice_tenant")
  platformPayments PlatformPayment[] @relation("PlatformPayment_tenant")
  supportAccessGrants SupportAccessGrant[] @relation("SupportAccessGrant_tenant")
  tenantUsageCounters TenantUsageCounter[] @relation("TenantUsageCounter_tenant")
  users User[] @relation("User_tenant")
  sessions Session[] @relation("Session_tenant")
  otpChallenges OtpChallenge[] @relation("OtpChallenge_tenant")
  roles Role[] @relation("Role_tenant")
  memberships Membership[] @relation("Membership_tenant")
  membershipPropertyScopes MembershipPropertyScope[] @relation("MembershipPropertyScope_tenant")
  invites Invite[] @relation("Invite_tenant")
  portfolios Portfolio[] @relation("Portfolio_tenant")
  propertys Property[] @relation("Property_tenant")
  buildings Building[] @relation("Building_tenant")
  floors Floor[] @relation("Floor_tenant")
  spaces Space[] @relation("Space_tenant")
  documents Document[] @relation("Document_tenant")
  renters Renter[] @relation("Renter_tenant")
  renterDocuments RenterDocument[] @relation("RenterDocument_tenant")
  agreements Agreement[] @relation("Agreement_tenant")
  agreementSpaces AgreementSpace[] @relation("AgreementSpace_tenant")
  chargeTypes ChargeType[] @relation("ChargeType_tenant")
  agreementCharges AgreementCharge[] @relation("AgreementCharge_tenant")
  rentEscalations RentEscalation[] @relation("RentEscalation_tenant")
  invoiceCounters InvoiceCounter[] @relation("InvoiceCounter_tenant")
  invoices Invoice[] @relation("Invoice_tenant")
  invoiceLines InvoiceLine[] @relation("InvoiceLine_tenant")
  payments Payment[] @relation("Payment_tenant")
  paymentAllocations PaymentAllocation[] @relation("PaymentAllocation_tenant")
  deposits Deposit[] @relation("Deposit_tenant")
  depositTransactions DepositTransaction[] @relation("DepositTransaction_tenant")
  lateFeeRules LateFeeRule[] @relation("LateFeeRule_tenant")
  utilityMeters UtilityMeter[] @relation("UtilityMeter_tenant")
  meterReadings MeterReading[] @relation("MeterReading_tenant")
  ledgerAccounts LedgerAccount[] @relation("LedgerAccount_tenant")
  journals Journal[] @relation("Journal_tenant")
  ledgerEntrys LedgerEntry[] @relation("LedgerEntry_tenant")
  expenseCategorys ExpenseCategory[] @relation("ExpenseCategory_tenant")
  vendors Vendor[] @relation("Vendor_tenant")
  expenses Expense[] @relation("Expense_tenant")
  ownershipShares OwnershipShare[] @relation("OwnershipShare_tenant")
  maintenanceRequests MaintenanceRequest[] @relation("MaintenanceRequest_tenant")
  maintenanceComments MaintenanceComment[] @relation("MaintenanceComment_tenant")
  maintenanceAttachments MaintenanceAttachment[] @relation("MaintenanceAttachment_tenant")
  notices Notice[] @relation("Notice_tenant")
  noticeRecipients NoticeRecipient[] @relation("NoticeRecipient_tenant")
  notificationOutboxs NotificationOutbox[] @relation("NotificationOutbox_tenant")
  inAppNotifications InAppNotification[] @relation("InAppNotification_tenant")
  smsUsages SmsUsage[] @relation("SmsUsage_tenant")
  importJobs ImportJob[] @relation("ImportJob_tenant")
  idempotencyKeys IdempotencyKey[] @relation("IdempotencyKey_tenant")
  auditLogs AuditLog[] @relation("AuditLog_tenant")
  tenantFeatureFlags TenantFeatureFlag[] @relation("TenantFeatureFlag_tenant")
  aiConversations AiConversation[] @relation("AiConversation_tenant")
  aiMessages AiMessage[] @relation("AiMessage_tenant")

  @@map("tenants")
}

model TenantDomain {
  id String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  hostname String @unique @db.Citext
  type DomainType
  isPrimary Boolean @default(false) @map("is_primary")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verificationToken String? @map("verification_token")
  sslStatus SslStatus @default(PENDING) @map("ssl_status")
  cfCustomHostnameId String? @map("cf_custom_hostname_id")
  isActive Boolean @default(true) @map("is_active")
  releasedAt DateTime? @db.Timestamptz(6) @map("released_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant Tenant @relation("TenantDomain_tenant", fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("tenant_domains")
}

model ReservedSlug {
  slug String @id @db.Citext
  reason String?

  @@map("reserved_slugs")
}

model SlugReservation {
  slug String @id @db.Citext
  releasedFromTenantId String @db.Uuid @map("released_from_tenant_id")
  reservedUntil DateTime @db.Timestamptz(6) @map("reserved_until")

  @@map("slug_reservations")
}

// ============================ PLATFORM RBAC (আমাদের নিজের ওয়েবসাইট/অ্যাডমিন প্যানেল) ============================

// role এখন enum নয়, মডেল। isSuperAdmin = true → সব permission bypass (permission row লাগে না)।
// SQL ফাইলে: partial unique (is_super_admin = true) শুধু system role এ; শেষ active super admin ডিলিট/ডিঅ্যাকটিভ আটকানোর trigger।
model PlatformRole {
  id String @id @default(uuid(7)) @db.Uuid
  code String @unique
  nameBn String @map("name_bn")
  nameEn String @map("name_en")
  description String?
  isSuperAdmin Boolean @default(false) @map("is_super_admin")
  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  platformUsersByRole PlatformUser[] @relation("PlatformUser_role")
  platformRolePermissionsByRole PlatformRolePermission[] @relation("PlatformRolePermission_role")

  @@map("platform_roles")
}

// code যেমন "tenant.create", "billing.view", "support_access.grant"
model PlatformPermission {
  code String @id
  module String
  action PermissionAction
  descriptionBn String? @map("description_bn")
  descriptionEn String? @map("description_en")
  sortOrder Int @default(0) @map("sort_order")

  platformRolePermissionsByPermission PlatformRolePermission[] @relation("PlatformRolePermission_permission")

  @@unique([module, action])
  @@index([module, sortOrder])
  @@map("platform_permissions")
}

model PlatformRolePermission {
  roleId String @db.Uuid @map("role_id")
  permissionCode String @map("permission_code")

  role PlatformRole @relation("PlatformRolePermission_role", fields: [roleId], references: [id], onDelete: Restrict)
  permission PlatformPermission @relation("PlatformRolePermission_permission", fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("platform_role_permissions")
}

model PlatformUser {
  id String @id @default(uuid(7)) @db.Uuid
  email String @unique @db.Citext
  name String
  passwordHash String @map("password_hash")
  roleId String @db.Uuid @map("role_id")
  isActive Boolean @default(true) @map("is_active")
  lastLoginAt DateTime? @db.Timestamptz(6) @map("last_login_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  role PlatformRole @relation("PlatformUser_role", fields: [roleId], references: [id], onDelete: Restrict)
  platformPaymentsByRecordedBy PlatformPayment[] @relation("PlatformPayment_recordedBy")
  platformSessionsByPlatformUser PlatformSession[] @relation("PlatformSession_platformUser")
  platformMfa PlatformMfa? @relation("PlatformMfa_platformUser")
  supportAccessGrantsByAgent SupportAccessGrant[] @relation("SupportAccessGrant_agent")
  supportAccessGrantsByGrantedBy SupportAccessGrant[] @relation("SupportAccessGrant_grantedBy")
  platformAuditLogsByPlatformUser PlatformAuditLog[] @relation("PlatformAuditLog_platformUser")

  @@index([roleId])
  @@map("platform_users")
}

model Subscription {
  id String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  planId String @db.Uuid @map("plan_id")
  status SubscriptionStatus
  trialEndsAt DateTime? @db.Timestamptz(6) @map("trial_ends_at")
  currentPeriodStart DateTime? @db.Timestamptz(6) @map("current_period_start")
  currentPeriodEnd DateTime? @db.Timestamptz(6) @map("current_period_end")
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant Tenant @relation("Subscription_tenant", fields: [tenantId], references: [id], onDelete: Restrict)
  plan Plan @relation("Subscription_plan", fields: [planId], references: [id], onDelete: Restrict)
  platformInvoicesBySubscription PlatformInvoice[] @relation("PlatformInvoice_subscription")

  @@index([tenantId])
  @@map("subscriptions")
}

model PlatformInvoice {
  id String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  subscriptionId String @db.Uuid @map("subscription_id")
  number String @unique
  periodStart DateTime @db.Date @map("period_start")
  periodEnd DateTime @db.Date @map("period_end")
  amount Decimal @db.Decimal(14, 2)
  currency String @default("BDT") @db.Char(3)
  status PlatformInvoiceStatus @default(DRAFT)
  dueDate DateTime @db.Date @map("due_date")
  issuedAt DateTime? @db.Timestamptz(6) @map("issued_at")
  paidAt DateTime? @db.Timestamptz(6) @map("paid_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant Tenant @relation("PlatformInvoice_tenant", fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription @relation("PlatformInvoice_subscription", fields: [subscriptionId], references: [id], onDelete: Restrict)
  platformPaymentsByPlatformInvoice PlatformPayment[] @relation("PlatformPayment_platformInvoice")

  @@map("platform_invoices")
}

model PlatformPayment {
  id String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  platformInvoiceId String @db.Uuid @map("platform_invoice_id")
  amount Decimal @db.Decimal(14, 2)
  method PaymentMethod
  reference String?
  paidAt DateTime @db.Timestamptz(6) @map("paid_at")
  recordedByPlatformUserId String? @db.Uuid @map("recorded_by_platform_user_id")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  tenant Tenant @relation("PlatformPayment_tenant", fields: [tenantId], references: [id], onDelete: Restrict)
  platformInvoice PlatformInvoice @relation("PlatformPayment_platformInvoice", fields: [platformInvoiceId], references: [id], onDelete: Restrict)
  recordedBy PlatformUser? @relation("PlatformPayment_recordedBy", fields: [recordedByPlatformUserId], references: [id], onDelete: Restrict)

  @@map("platform_payments")
}

model PlatformSession {
  id String @id @default(uuid(7)) @db.Uuid
  platformUserId String @db.Uuid @map("platform_user_id")
  tokenHash String @unique @map("token_hash")
  ip String?
  userAgent String? @map("user_agent")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  platformUser PlatformUser @relation("PlatformSession_platformUser", fields: [platformUserId], references: [id], onDelete: Restrict)

  @@map("platform_sessions")
}

model PlatformMfa {
  platformUserId String @id @db.Uuid @map("platform_user_id")
  totpSecretEnc String @map("totp_secret_enc")
  enabledAt DateTime? @db.Timestamptz(6) @map("enabled_at")
  recoveryCodesHash String[] @map("recovery_codes_hash")

  platformUser PlatformUser @relation("PlatformMfa_platformUser", fields: [platformUserId], references: [id], onDelete: Restrict)

  @@map("platform_mfa")
}

// scope এর মান = PlatformPermission.code (অ্যাপ লেয়ারে validate; Prisma তে array-FK নেই)
model SupportAccessGrant {
  id String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  platformUserId String @db.Uuid @map("platform_user_id")
  grantedById String @db.Uuid @map("granted_by_id")
  scope String[]
  reason String
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  revokedAt DateTime? @db.Timestamptz(6) @map("revoked_at")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  tenant Tenant @relation("SupportAccessGrant_tenant", fields: [tenantId], references: [id], onDelete: Restrict)
  agent PlatformUser @relation("SupportAccessGrant_agent", fields: [platformUserId], references: [id], onDelete: Restrict)
  grantedBy PlatformUser @relation("SupportAccessGrant_grantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([platformUserId, expiresAt])
  @@map("support_access_grants")
}

// tenantId এখানে ইচ্ছা করে FK নয় (tenant আর্কাইভ হলেও audit থাকবে)
model PlatformAuditLog {
  id String @id @default(uuid(7)) @db.Uuid
  platformUserId String? @db.Uuid @map("platform_user_id")
  tenantId String? @db.Uuid @map("tenant_id")
  action String
  entityType String? @map("entity_type")
  entityId String? @map("entity_id")
  before Json?
  after Json?
  ip String?
  requestId String? @map("request_id")
  createdAt DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  platformUser PlatformUser? @relation("PlatformAuditLog_platformUser", fields: [platformUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("platform_audit_logs")
}

model TenantUsageCounter {
  tenantId String @db.Uuid @map("tenant_id")
  key String
  value Int @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(6) @map("updated_at")

  tenant Tenant @relation("TenantUsageCounter_tenant", fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, key])
  @@map("tenant_usage_counters")
}

// ============================ TENANT USERS & RBAC (ক্লায়েন্টের নিজস্ব) ============================

// CHECK (phone IS NOT NULL OR email IS NOT NULL) → sql/rls_and_constraints.sql
model User {
  id String @id @default(uuid(7)) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  kind UserKind
  name String
  phone String?
  email String? @db.Citext
  passwordHash String? @map("password_hash")
  locale String @default("bn")
  theme String @default("system")
  isActive Boolean @default(true) @map("is_active")
